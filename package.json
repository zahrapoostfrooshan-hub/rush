{
  "name": "shop-rush-2",
  "version": "1.0.0",
  "private": true,
  "description": "Shop Rush 2 - Erfan Edition, a lightweight 3D supermarket management game",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.9",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.erfan.shoprush2",
    "productName": "Shop Rush 2 - Erfan Edition",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
